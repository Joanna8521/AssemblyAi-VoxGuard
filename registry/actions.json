  "risk_levels": {
    "L0": {
      "name": "Reason",
      "default": "AUTO"
    },
    "L1": {
      "name": "Read",
      "default": "AUTO"
    },
    "L2": {
      "name": "Draft / internal write",
      "default": "AUTO"
    },
    "L3": {
      "name": "External write",
      "default": "POLICY"
    },
    "L4": {
      "name": "Financial / destructive",
      "default": "ASK"
    },
