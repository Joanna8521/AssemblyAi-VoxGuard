  "condition_vocabulary": {
    "$comment": "Allowed condition keys and their values. String-valued fields are enumerated so a policy and an action request cannot describe the same group with two different words. Numeric fields are free, because a person can say any number.",
    "customer_group": {
      "type": "string",
      "enum": [
        "all",
        "paid_affected",
        "unpaid",
        "cart_abandoners",
        "subscribers",
        "vip"
      ]
    },
    "platform": {
      "type": "string",
      "enum": [
        "shopee",
        "momo",
        "pchome",
        "yahoo",
        "amazon",
        "website",
        "line_shopping",
        "meta",
        "google"
      ]
    },
    "channel": {
      "type": "string",
      "enum": [
        "line",
        "email",
        "sms",
        "push",
        "social"
      ]
    },
    "increase_percent": {
      "type": "number"
    },
    "decrease_percent": {
      "type": "number"
    },
    "daily_total": {
      "type": "number"
    },
    "amount": {
      "type": "number"
    },
    "count": {
      "type": "integer"
    },
    "roas": {
      "type": "number"
    }
  }
