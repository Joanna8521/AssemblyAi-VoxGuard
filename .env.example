# AssemblyAI. Get a key at https://www.assemblyai.com/app/api-keys
# The key stays server-side: the browser never holds it. server/index.js mints a
# short-lived, single-use token per connection instead.
ASSEMBLYAI_API_KEY=

# Optional. Defaults are fine for local work.
PORT=8787

# Telegram, the one adapter that actually reaches somebody. Without these,
# every action falls back to the sandbox and the interface says so.
# Bot token from @BotFather; chat ids from @userinfobot or getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OPS_CHAT_ID=
TELEGRAM_CUSTOMER_CHAT_ID=
